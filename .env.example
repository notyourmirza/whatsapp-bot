# WA Convo v4.2 — WhatsApp Automation Platform
# Copy this file to .env and fill in your values

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
# Use 0.0.0.0 on a hosting panel; 127.0.0.1 is for local-only binding.
HOST=0.0.0.0

# ─── Authentication ───────────────────────────────────────────────────────────
# Bearer token for API authentication. Leave empty to disable (dev only)
API_KEY=

# ─── Clients ──────────────────────────────────────────────────────────────────
# Number of WhatsApp client slots to create (1-6)
CLIENT_COUNT=6

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite path and retention are configured in config/config.json.

# ─── Webhook (Legacy — use /webhooks API instead) ────────────────────────────
# Auto-migrated to webhook system on first startup
# WEBHOOK_URL=

# ─── Meta Cloud API ──────────────────────────────────────────────────────────
# App secret for HMAC signature verification on incoming Meta webhooks
# META_APP_SECRET=
# Verify token for Meta webhook hub verification
# WHATSAPP_VERIFY_TOKEN=

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=*

# ─── Rate Limiting ────────────────────────────────────────────────────────────
# Max requests per IP per minute
RATE_LIMIT_MAX=60

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── AI Integration ──────────────────────────────────────────────────────────
# AI providers and credentials are configured in config/config.json or in the
# dashboard Settings page; these AI_* names are not read as environment vars.

# ─── SSL / TLS ───────────────────────────────────────────────────────────────
# SSL_ENABLED=false
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem
